{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pharos-on-chain-alert-bot",
  "main": "worker.js",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pharos-alert-state",
      "database_id": "9e86b186-4a39-4523-a985-db3b8d0c499a",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
